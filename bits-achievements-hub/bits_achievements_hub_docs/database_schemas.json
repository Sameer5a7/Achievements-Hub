{
  "Users": {
    "fields": {
      "_id": "ObjectId (auto-generated)",
      "fullName": "String, required",
      "email": "String, required, unique",
      "password": "String, required, hashed with bcrypt",
      "studentId": "String, required for students",
      "facultyId": "String, required for faculty",
      "branch": "String, enum: ['CSE', 'EEE', 'ECE', 'MECH', 'CIVIL', 'Data Science']",
      "year": "Number, for students only",
      "role": "String, enum: ['Student', 'Faculty', 'Admin'], default: 'Student'",
      "dateOfBirth": "Date",
      "createdAt": "Date, default: Date.now",
      "updatedAt": "Date, default: Date.now"
    },
    "indexes": [
      "email",
      "studentId",
      "facultyId",
      "role"
    ]
  },
  "Posts": {
    "fields": {
      "_id": "ObjectId (auto-generated)",
      "title": "String, required",
      "content": "String, required",
      "uploadedBy": "ObjectId, ref: 'User', required",
      "branch": "String, enum: ['CSE', 'EEE', 'ECE', 'MECH', 'CIVIL', 'Data Science']",
      "pdfFile": "String, file path",
      "status": "String, enum: ['pending', 'approved', 'rejected'], default: 'pending'",
      "likes": "[ObjectId], ref: 'User'",
      "dislikes": "[ObjectId], ref: 'User'",
      "likeCount": "Number, default: 0",
      "dislikeCount": "Number, default: 0",
      "createdAt": "Date, default: Date.now",
      "updatedAt": "Date, default: Date.now"
    },
    "indexes": [
      "uploadedBy",
      "branch",
      "status",
      "createdAt"
    ]
  },
  "PDFs": {
    "fields": {
      "_id": "ObjectId (auto-generated)",
      "originalName": "String, required",
      "fileName": "String, required, unique",
      "filePath": "String, required",
      "fileSize": "Number, required",
      "mimeType": "String, required",
      "uploadedBy": "ObjectId, ref: 'User', required",
      "postId": "ObjectId, ref: 'Post'",
      "branch": "String",
      "createdAt": "Date, default: Date.now"
    },
    "indexes": [
      "uploadedBy",
      "postId",
      "branch"
    ]
  }
}