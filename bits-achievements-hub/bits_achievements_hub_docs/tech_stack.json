{
  "Frontend": {
    "React.js": {
      "version": "^18.2.0",
      "purpose": "User interface library",
      "key_features": [
        "Component-based",
        "Virtual DOM",
        "State management"
      ]
    },
    "React Router": {
      "version": "^6.8.0",
      "purpose": "Client-side routing",
      "key_features": [
        "Nested routes",
        "Route protection",
        "Navigation"
      ]
    },
    "Tailwind CSS": {
      "version": "^3.2.0",
      "purpose": "Utility-first CSS framework",
      "key_features": [
        "Responsive design",
        "Custom components",
        "Dark mode"
      ]
    },
    "Redux Toolkit": {
      "version": "^1.9.0",
      "purpose": "State management (optional)",
      "key_features": [
        "Centralized state",
        "DevTools",
        "Async actions"
      ]
    }
  },
  "Backend": {
    "Node.js": {
      "version": ">=16.0.0",
      "purpose": "JavaScript runtime",
      "key_features": [
        "Non-blocking I/O",
        "Event-driven",
        "NPM ecosystem"
      ]
    },
    "Express.js": {
      "version": "^4.18.0",
      "purpose": "Web application framework",
      "key_features": [
        "Middleware",
        "Routing",
        "REST APIs"
      ]
    },
    "Mongoose": {
      "version": "^6.8.0",
      "purpose": "MongoDB object modeling",
      "key_features": [
        "Schema validation",
        "Middleware",
        "Query building"
      ]
    },
    "JWT": {
      "package": "jsonwebtoken",
      "version": "^9.0.0",
      "purpose": "Authentication tokens",
      "key_features": [
        "Stateless auth",
        "Secure",
        "Cross-platform"
      ]
    },
    "Bcrypt": {
      "version": "^5.1.0",
      "purpose": "Password hashing",
      "key_features": [
        "Salt rounds",
        "Secure hashing",
        "Password verification"
      ]
    },
    "Multer": {
      "version": "^1.4.5",
      "purpose": "File upload handling",
      "key_features": [
        "Multipart/form-data",
        "File filtering",
        "Storage options"
      ]
    }
  },
  "Database": {
    "MongoDB": {
      "version": ">=5.0",
      "purpose": "NoSQL document database",
      "key_features": [
        "Flexible schema",
        "Scalability",
        "Aggregation pipeline"
      ]
    }
  },
  "Development Tools": {
    "Nodemon": {
      "version": "^2.0.0",
      "purpose": "Development server auto-restart"
    },
    "Concurrently": {
      "version": "^7.6.0",
      "purpose": "Run multiple npm scripts"
    },
    "Dotenv": {
      "version": "^16.0.0",
      "purpose": "Environment variables management"
    }
  }
}