{
  "Authentication": {
    "POST /api/auth/register": {
      "description": "User registration",
      "body": [
        "fullName",
        "email",
        "password",
        "studentId",
        "branch",
        "year",
        "role"
      ],
      "response": "User object + JWT token"
    },
    "POST /api/auth/login": {
      "description": "User login",
      "body": [
        "email",
        "password"
      ],
      "response": "User object + JWT token"
    },
    "POST /api/auth/forgot-password": {
      "description": "Password reset request",
      "body": [
        "email"
      ],
      "response": "Success message"
    }
  },
  "Users": {
    "GET /api/users/profile": {
      "description": "Get user profile",
      "auth_required": true,
      "response": "User profile data"
    },
    "PUT /api/users/profile": {
      "description": "Update user profile",
      "auth_required": true,
      "body": [
        "fullName",
        "branch",
        "year"
      ],
      "response": "Updated user object"
    }
  },
  "Posts": {
    "GET /api/posts": {
      "description": "Get all approved posts",
      "query_params": [
        "branch",
        "page",
        "limit"
      ],
      "response": "Array of posts"
    },
    "POST /api/posts": {
      "description": "Create new post",
      "auth_required": true,
      "body": [
        "title",
        "content",
        "branch",
        "pdfFile"
      ],
      "response": "Created post object"
    },
    "PUT /api/posts/:id/like": {
      "description": "Like/unlike a post",
      "auth_required": true,
      "response": "Updated like count"
    },
    "PUT /api/posts/:id/dislike": {
      "description": "Dislike/undislike a post",
      "auth_required": true,
      "response": "Updated dislike count"
    }
  },
  "Admin": {
    "GET /api/admin/users": {
      "description": "Get all users",
      "auth_required": true,
      "admin_only": true,
      "response": "Array of users"
    },
    "DELETE /api/admin/users/:id": {
      "description": "Delete user",
      "auth_required": true,
      "admin_only": true,
      "response": "Success message"
    },
    "GET /api/admin/posts/pending": {
      "description": "Get pending posts for approval",
      "auth_required": true,
      "admin_only": true,
      "response": "Array of pending posts"
    },
    "PUT /api/admin/posts/:id/approve": {
      "description": "Approve a post",
      "auth_required": true,
      "admin_only": true,
      "response": "Updated post object"
    },
    "PUT /api/admin/posts/:id/reject": {
      "description": "Reject a post",
      "auth_required": true,
      "admin_only": true,
      "response": "Updated post object"
    }
  },
  "File Upload": {
    "POST /api/upload/pdf": {
      "description": "Upload PDF file",
      "auth_required": true,
      "content_type": "multipart/form-data",
      "response": "File path and metadata"
    }
  }
}